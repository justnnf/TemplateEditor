<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <ArcGISAddInInstallFolder>$(registry:HKEY_CURRENT_USER\Software\Microsoft\Windows\CurrentVersion\Explorer\User Shell Folders@Personal)\ArcGIS\AddIns\ArcGISPro\</ArcGISAddInInstallFolder>
  </PropertyGroup>

  <PropertyGroup>
    <TargetFramework>net8.0-windows7.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <PlatformTarget>x64</PlatformTarget>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <OutputType>Library</OutputType>
    <AssemblyName>TemplateEditor</AssemblyName>
    <RootNamespace>TemplateEditor</RootNamespace>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <NoWarn>CA1416</NoWarn>
    <AddInName>TemplateEditor</AddInName>
    <AddInDescription>Template editor tools</AddInDescription>
    <AddInImage>Images\AddInDesktopMap.png</AddInImage>
    <AddInAuthor>TemplateEditor</AddInAuthor>
    <AddInCompany>TemplateEditor</AddInCompany>
    <AddInVersion>1.7.9</AddInVersion>
    <ArcGISProReleaseVersion>3.3</ArcGISProReleaseVersion>
    <ReleaseDirectory>$(MSBuildProjectDirectory)\Release\</ReleaseDirectory>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="Config.daml" />
    <Content Remove="TemplateEditor\AllowedAssociationRules.json" />
    <Content Remove="TemplateEditor\PlacementAttributeOverrides.json" />
    <None Update="TemplateEditor\AllowedAssociationRules.json">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </None>
    <None Update="TemplateEditor\PlacementAttributeOverrides.json">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <Content Include="Config.daml" />
    <Content Include="Images\AddInDesktopMap.png" />
    <Content Include="Images\SettingsVectorIcon16.xaml" />
    <Content Include="Images\SettingsVectorIcon32.xaml" />
    <Content Include="Images\ReloadVectorIcon16.xaml" />
    <Content Include="Images\ReloadVectorIcon32.xaml" />
    <Content Include="Images\TemplatesVectorIcon16.xaml" />
    <Content Include="Images\TemplatesVectorIcon32.xaml" />
    <Content Include="DarkImages\SettingsVectorIcon16.xaml" />
    <Content Include="DarkImages\SettingsVectorIcon32.xaml" />
    <Content Include="DarkImages\ReloadVectorIcon16.xaml" />
    <Content Include="DarkImages\ReloadVectorIcon32.xaml" />
    <Content Include="DarkImages\TemplatesVectorIcon16.xaml" />
    <Content Include="DarkImages\TemplatesVectorIcon32.xaml" />
    <Content Include="Images\lineCursor.cur">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Images\pointCursor.cur">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Images\polygonCursor.cur">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Images\tableCursor.cur">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <None Include=".github\copilot-instructions.md" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="ArcGIS.Desktop.Framework">
      <HintPath>$(UserProfile)\.nuget\packages\esri.arcgispro.extensions30\3.3.0.52636\ref\net8.0-windows7.0\ArcGIS.Desktop.Framework.dll</HintPath>
      <CopyLocal>False</CopyLocal>
      <Private>False</Private>
    </Reference>
    <Reference Include="ArcGIS.Core">
      <HintPath>$(UserProfile)\.nuget\packages\esri.arcgispro.extensions30\3.3.0.52636\ref\net8.0-windows7.0\ArcGIS.Core.dll</HintPath>
      <CopyLocal>False</CopyLocal>
      <Private>False</Private>
    </Reference>
    <Reference Include="ArcGIS.Desktop.Core">
      <HintPath>$(UserProfile)\.nuget\packages\esri.arcgispro.extensions30\3.3.0.52636\ref\net8.0-windows7.0\ArcGIS.Desktop.Core.dll</HintPath>
      <CopyLocal>False</CopyLocal>
      <Private>False</Private>
    </Reference>
    <Reference Include="ArcGIS.Desktop.Extensions">
      <HintPath>$(UserProfile)\.nuget\packages\esri.arcgispro.extensions30\3.3.0.52636\ref\net8.0-windows7.0\ArcGIS.Desktop.Extensions.dll</HintPath>
      <CopyLocal>False</CopyLocal>
      <Private>False</Private>
    </Reference>
    <Reference Include="ArcGIS.Desktop.Editing">
      <HintPath>$(UserProfile)\.nuget\packages\esri.arcgispro.extensions30\3.3.0.52636\ref\net8.0-windows7.0\ArcGIS.Desktop.Editing.dll</HintPath>
      <CopyLocal>False</CopyLocal>
      <Private>False</Private>
    </Reference>
    <Reference Include="ArcGIS.Desktop.Mapping">
      <HintPath>$(UserProfile)\.nuget\packages\esri.arcgispro.extensions30\3.3.0.52636\ref\net8.0-windows7.0\ArcGIS.Desktop.Mapping.dll</HintPath>
      <CopyLocal>False</CopyLocal>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

  <Import Project="Esri.ArcGISPro.Extensions.targets" Condition="Exists('Esri.ArcGISPro.Extensions.targets')" />

  <Target Name="GenerateVersionedAssemblyAttributes" BeforeTargets="CoreCompile">
    <PropertyGroup>
      <VersionedAssemblyInfo>$(IntermediateOutputPath)VersionInfo.cs</VersionedAssemblyInfo>
    </PropertyGroup>
    <ItemGroup>
      <VersionedAssemblyAttribute Include="System.Reflection.AssemblyVersionAttribute">
        <_Parameter1>$(AddInVersion)</_Parameter1>
      </VersionedAssemblyAttribute>
      <VersionedAssemblyAttribute Include="System.Reflection.AssemblyFileVersionAttribute">
        <_Parameter1>$(AddInVersion)</_Parameter1>
      </VersionedAssemblyAttribute>
      <VersionedAssemblyAttribute Include="System.Reflection.AssemblyInformationalVersionAttribute">
        <_Parameter1>$(AddInVersion)</_Parameter1>
      </VersionedAssemblyAttribute>
    </ItemGroup>
    <WriteCodeFragment Language="CS" OutputFile="$(VersionedAssemblyInfo)" AssemblyAttributes="@(VersionedAssemblyAttribute)" />
    <ItemGroup>
      <Compile Include="$(VersionedAssemblyInfo)" />
    </ItemGroup>
  </Target>

  <Target Name="StampAddInPackageVersion" AfterTargets="PackageArcGISContents" Condition="'$(_ArcGISExtension)' != '' And Exists('$(_ArcGISPackageFile)')">
    <Exec Command="powershell.exe -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\Tools\Set-AddInManifestVersion.ps1&quot; -PackagePath &quot;$(_ArcGISPackageFile)&quot; -Version &quot;$(AddInVersion)&quot;" />
    <Exec Command="RegisterAddIn.exe &quot;$(_ArcGISPackageFile)&quot; /s" WorkingDirectory="$(ArcGISFolder)" Condition="Exists('$(ArcGISFolder)RegisterAddIn.exe')" />
    <Copy SourceFiles="$(_ArcGISPackageFile)" DestinationFolder="$(ArcGISAddInInstallFolder)" />
    <Message Text="Updated the installed add-in package to version $(AddInVersion)" Importance="High" />
  </Target>

  <Target Name="CopyAddInToReleaseFolder" AfterTargets="StampAddInPackageVersion" Condition="'$(_ArcGISExtension)' != '' And Exists('$(_ArcGISPackageFile)')">
    <PropertyGroup>
      <ReleaseAddInFileName>$(AssemblyName).ArcPro.$(ArcGISProReleaseVersion).v.$(AddInVersion)$(_ArcGISExtension)</ReleaseAddInFileName>
    </PropertyGroup>
    <MakeDir Directories="$(ReleaseDirectory)" />
    <Copy SourceFiles="$(_ArcGISPackageFile)" DestinationFiles="$(ReleaseDirectory)$(ReleaseAddInFileName)" SkipUnchangedFiles="true" />
    <Message Text="Copied $(_ArcGISPackageFile) to $(ReleaseDirectory)$(ReleaseAddInFileName)" Importance="High" />
  </Target>
</Project>
