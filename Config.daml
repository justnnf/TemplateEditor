<?xml version="1.0" encoding="utf-8"?>
<ArcGIS defaultAssembly="TemplateEditor.dll" defaultNamespace="TemplateEditor" xmlns="http://schemas.esri.com/DADF/Registry" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://schemas.esri.com/DADF/Registry file:///C:/Program%20Files/ArcGIS/Pro/bin/ArcGIS.Desktop.Framework.xsd">
  <AddInInfo id="{51ca91f3-e005-4b62-863c-c0a618aada65}" version="1.6.0" desktopVersion="3.3.5" product="ArcGISPro">
    <Name>Template Editor</Name>
    <Description>Template editor tools</Description>
    <Image>Images/MapBadgeIcons/AddInDesktopMap.png</Image>
    <Author>FortisAlberta</Author>
    <Company>FortisAlberta</Company>
    <Date>05/17/2026</Date>
    <Subject>Framework</Subject>
  </AddInInfo>
  <modules>
    <insertModule id="TemplateEditor_Module" className="TemplateEditor.AddinModule" autoLoad="true" caption="AddinModule">
      <tabs>
        <tab id="TemplateEditor_EditorTab" caption="Templates" keytip="">
          <group refID="TemplateEditor_EditorGroup" />
        </tab>
      </tabs>
      <groups>
        <group id="TemplateEditor_EditorGroup" caption="Templates" appearsOnAddInTab="false" keytip="">
          <button refID="TemplateEditor_TemplateSettings" size="large" />
          <button refID="TemplateEditor_OpenEditorDockpane" size="large" />
          <button refID="TemplateEditor_ReloadConfig" size="large" />
        </group>
      </groups>
      <controls>
        <tool id="TemplateEditor_SketchPointTool" caption="SketchPointTool" className="TemplateEditor.SketchPointTool" loadOnClick="true" smallImage="GenericButtonRed16" largeImage="GenericButtonRed32" condition="esri_mapping_mapPane" keytip="">
          <tooltip heading="Place Point Template">Place the selected point template.<disabledText /></tooltip>
        </tool>
        <tool id="TemplateEditor_SketchPolylineTool" caption="SketchPolylineTool" className="TemplateEditor.SketchPolylineTool" loadOnClick="true" smallImage="GenericButtonRed16" largeImage="GenericButtonRed32" condition="esri_mapping_mapPane" keytip="">
          <tooltip heading="Place Line Template">Sketch a line for the selected template.<disabledText /></tooltip>
        </tool>
        <tool id="TemplateEditor_SketchPolygonTool" caption="SketchPolygonTool" className="TemplateEditor.SketchPolygonTool" loadOnClick="true" smallImage="GenericButtonRed16" largeImage="GenericButtonRed32" condition="esri_mapping_mapPane" keytip="">
          <tooltip heading="Place Polygon Template">Sketch a polygon for the selected template.<disabledText /></tooltip>
        </tool>
        <tool id="TemplateEditor_AddRowTool" caption="AddRowTool" className="TemplateEditor.AddRowTool" loadOnClick="true" smallImage="GenericButtonRed16" largeImage="GenericButtonRed32" condition="esri_mapping_mapPane" keytip="">
          <tooltip heading="Create Table Row">Create a non-spatial row for the selected template.<disabledText /></tooltip>
        </tool>
        <button id="TemplateEditor_TemplateSettings" caption="Settings" className="TemplateEditor.TemplateSettingsButton" loadOnClick="true" smallImage="Images/MapBadgeIcons/ConfigSettingsMap.png" largeImage="Images/MapBadgeIcons/ConfigSettingsMap.png" keytip="">
          <tooltip heading="Settings">Choose the template config file and placement options.<disabledText /></tooltip>
        </button>
        <button id="TemplateEditor_OpenEditorDockpane" caption="Open Editor" className="TemplateEditor.EditorDockpane_ShowButton" loadOnClick="true" smallImage="Images/MapBadgeIcons/TemplateEditorMap.png" largeImage="Images/MapBadgeIcons/TemplateEditorMap.png" keytip="">
          <tooltip heading="Open Editor">Open the template editor.<disabledText /></tooltip>
        </button>
        <button id="TemplateEditor_ReloadConfig" caption="Reload Config" loadOnClick="true" smallImage="Images/MapBadgeIcons/ReloadConfigMap.png" largeImage="Images/MapBadgeIcons/ReloadConfigMap.png" keytip="">
          <tooltip heading="Reload Config">Reload the selected template configuration file.<disabledText /></tooltip>
        </button>
      </controls>
      <dockPanes>
        <dockPane id="TemplateEditor_EditorDockpane" caption="Template Editor" className="TemplateEditor.EditorDockpaneViewModel" dock="bottom">
          <content className="TemplateEditor.EditorDockpaneView" />
        </dockPane>
      </dockPanes>
    </insertModule>
  </modules>
</ArcGIS>
